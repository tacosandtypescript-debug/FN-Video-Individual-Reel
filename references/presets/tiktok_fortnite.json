    "top_f": 0.0725,
    "bottom_f": 0.174
  },
  "encode": {
    "vcodec": "h264_nvenc",
    "preset": "p5",
    "cq": 21,
    "pix_fmt": "yuv420p",
    "acodec": "aac",
    "audio_bitrate": "96k"
  }
}
