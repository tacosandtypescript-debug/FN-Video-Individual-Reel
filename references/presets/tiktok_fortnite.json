{
  "name": "tiktok_fortnite",
  "description": "Estilo TikTok Fortnite @khetzalgg: video central ancho completo, fondo cover blur, textos anclados con gap simetrico",
  "canvas": [1080, 1920],
  "gap_1080": 32,
  "spacing_1080": 18,
  "font_size_1080": 60,
  "auto_font": {
    "enabled": true,
    "max_size_1080": 84,
    "target_width_fraction": 0.82
  },
  "font": "/home/isaac/.local/share/fonts/Barlow-ExtraBoldItalic.ttf",
  "wave": 2,
  "wave_hz": 1.1,
  "outline": 5,
  "outline_color": "black",
  "foreground_corner_radius_1080": 18,
  "foreground_shadow": {
    "enabled": true,
    "offset_1080": 4,
    "blur_1080": 22,
    "opacity": 0.32
  },
  "blur": 16.0,
  "cover": true,
  "safe": {
    "left_f": 0.056,
    "right_f": 0.056,
    "top_f": 0.0725,
    "bottom_f": 0.174
  },
  "encode": {
    "vcodec": "h264_nvenc",
    "cpu_vcodec": "libx264",
    "preset": "p5",
    "cpu_preset": "medium",
    "cq": 21,
    "pix_fmt": "yuv420p",
    "acodec": "aac",
    "audio_bitrate": "96k"
  }
}
